# Конфиг для контейнеров (Compose читает env_file `.env.docker`).
# Скопируйте: copy .env.docker.example .env.docker  (или scripts/docker-start.* сделает это при отсутствии файла)

# OpenAI-compatible Chat Completions
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JSON_MODE=true

# Лимиты fetch (можно опустить — в core есть дефолты)
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=2000000

# Переменные REDIS_URL / OUTPUT_DIR задаёт docker-compose через environment поверх этого файла
