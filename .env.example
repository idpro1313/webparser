# Redis for BullMQ (required for apps/api + apps/worker)
REDIS_URL=redis://localhost:6379

# Parsed markdown output directory (jobs under <OUTPUT_DIR>/<jobId>/...)
OUTPUT_DIR=./output

# OpenAI-compatible Chat Completions
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: set false if provider rejects response_format json_object
OPENAI_JSON_MODE=true

# HTTP fetch limits
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=2000000

# API server
API_PORT=3000
